# ── Runtime ──────────────────────────────────────────────
# dry-run (default) | live
TREASURY_MODE=dry-run
# ripio | twin | full  (also set at build time for tree-shaking)
RAIL_PROVIDER=ripio
# mainnet (default) | testnet
NETWORK=mainnet

# ── Agent wallet ─────────────────────────────────────────
# NEVER commit the real key. Required for live txs and ERC-8004 register.
AGENT_PRIVATE_KEY=
# Merchant treasury address the agent manages (defaults to agent address)
TREASURY_ADDRESS=

# ── Celo attribution (ERC-8021) ──────────────────────────
# Loops-issued tag for this entry. Required for live Celo sends.
# Distinct from codeFromRepo("hnasar99/TreasuryBox") = celo_d2b464b37c2a.
CELO_ATTRIBUTION_CODE=celo_202a37e338a2

# ── RPC ──────────────────────────────────────────────────
CELO_RPC_URL=https://forno.celo.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ── Guards ───────────────────────────────────────────────
# Human-readable amounts in local units (e.g. 500000 ARS)
MAX_OP_AMOUNT=100000
MAX_DAILY_AMOUNT=500000
# Buffer days of scheduled supplier payments to keep liquid
LIQUIDITY_BUFFER_DAYS=7

# ── Inflation benchmark (monthly %, e.g. 2.5 = 2.5%/mo) ──
INFLATION_MONTHLY_PCT=2.5
# Local currency the merchant invoices in
HOME_CURRENCY=ARS

# ── Ripio / Celo token overrides (optional) ──────────────
# RAIL_WARS_ADDRESS=0x0dc4f92879b7670e5f4e4e6e3c801d229129d90d
# RAIL_WBRL_ADDRESS=0xd76f5faf6888e24d9f04bf92a0c8b921fe4390e0
