# ── Textile FX ───────────────────────────────────────────
TEXTILE_API_URL=https://api.textilecredit.com/v2
# TEXTILE_LIMIT_ORDER_REACTOR=0xa9AA0a64769cBed4d3B1Ceb4Df01CdE915C235b3

# ── x402 (Celo facilitator) ──────────────────────────────
X402_FACILITATOR_URL=https://api.x402.celo.org
# Public base URL used in payment links / agent.json (GitHub until a hosted demo exists)
PUBLIC_BASE_URL=https://github.com/hnasar99/TreasuryBox
# AGENT_URI=https://raw.githubusercontent.com/hnasar99/TreasuryBox/main/public/agent.json

# ── Ripio Ramp ───────────────────────────────────────────
RIPIO_RAMP_BASE=https://ramp.ripio.com
RIPIO_RAMP_COUNTRY=AR

# ── Panel ────────────────────────────────────────────────
PANEL_PORT=3000
NEXT_PUBLIC_RAIL_PROVIDER=ripio

# ── Model (eve) ──────────────────────────────────────────
# Prefer connecting via `eve login` / TUI. Optional direct key:
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
