# RAIL_USDT_ADDRESS=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e

# ── Twin / Arbitrum token overrides ──────────────────────
# RAIL_ARGT_ADDRESS=0x59863989d080B22476DB95656d0C3CC18be92214
